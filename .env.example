# SMTP email settings. For Gmail, use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your@gmail.com
SMTP_TO=alice@example.com,bob@example.com

# Ollama settings.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:27b
OLLAMA_API_KEY=your_ollama_api_key_for_web_search
OLLAMA_TOOL_ITERATIONS=6
LOG_FILE=logs/news_digest.log
LOG_LEVEL=INFO

# Digest settings.
DIGEST_TOPIC=latest cybersecurity news
DIGEST_MAX_ITEMS=12
DIGEST_TIME=08:00
